#!/usr/bin/env python3
# Part of the APK.audio project — http://APK.audio — made by Anthony Kuzub
# Pre-compiled executable entrypoint tracked as part of the Git repository.
import os
import sys

# Add SRC to python import path
HERE = os.path.dirname(os.path.abspath(__file__))
SRC_DIR = os.path.join(HERE, "..", "SRC")
sys.path.insert(0, SRC_DIR)

from manager import cli, runner  # noqa: E402

def main():
    runner.set_port_eviction('--no-kaboom' not in sys.argv[1:])
    if not [a for a in sys.argv[1:] if a != '--no-kaboom']:
        sys.argv.insert(1, 'serve')
    cli.run_cli_mode()

if __name__ == '__main__':
    main()
