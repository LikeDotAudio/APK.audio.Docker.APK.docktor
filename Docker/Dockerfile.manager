# 🐳 DockTor, as a container. The API and its client, nothing else.
#     docker compose -f 'APK:PODS/Docktor/Docker/docker-compose.manager.yml' up -d --build
#     open http://localhost:8765/
# The manager used to be a Tkinter window, so it could only run where there was
# a display — never on the headless host the containers run on. This is the same
# tool with an HTTP front door, installable BESIDE the stacks it manages.
# WHAT THE SOCKET ALONE CAN DO: the whole docker plane — ps, stats, inspect,
# restart, logs, rm. Every READ works with nothing but that mount.
# BUILDING IS DIFFERENT: `docker compose build` hands the DAEMON a context path,
# and the daemon is the host, so a compose file at /app/… names a directory the
# daemon cannot see and the build fails on a path rather than a Dockerfile. The
# repository is therefore bound at ITS OWN ABSOLUTE HOST PATH. Without that
# mount the manager still runs; up/rebuild fail naming the missing compose file.
# ⚠️ THE REPO ROOT HAS NO COLON IN IT AND THAT IS WHY THE MOUNT IS POSSIBLE.
#    Every directory below it does, and compose mount parser splits on `:` in
#    both forms. Bind the ROOT; never try to bind a directory under it.
# WHY THE PACKAGE IS COPIED IN AS WELL AS BOUND: so the image is a whole
# program. A manager that is only the mount starts, finds no code and exits —
# which is what an empty or wrong APKAUDIO_REPO produces, and a bind whose
# source does not exist is created by the daemon as an empty root-owned
# directory rather than refused. The COPY makes that failure "up.sh is missing"
# instead of "python: can't open file".
# JSON-ARRAY COPY THROUGHOUT: `docker scripts` has a space in it.

# The docker CLI and the compose plugin, already assembled. A python base
# instead means adding Docker apt repository and a key — four more layers to
# reach the same two binaries.
FROM docker:27-cli

# python3 for the manager, bash for the scripts (they use arrays, /dev/tcp and
# [[ ]], none of which ash has), curl for the app-plane probes in apps.sh, and
# coreutils for the `timeout` those probes are bounded with.
# ⚠️ mosquitto-clients IS NOT OPTIONAL DECORATION: apps.sh reads the broker own
#    $SYS counters with mosquitto_sub and says "mosquitto-clients is not
#    installed on this host" when it cannot — which is what the broker card said
#    for as long as this line did not name it. topics.sh needs it to census the
#    bus at all.
RUN apk add --no-cache python3 py3-pip bash curl coreutils docker-cli-compose \
        mosquitto-clients

# paho is the bus, and BEST EFFORT on purpose: bus.py returns a None client when
# the import fails, so a wheel that will not build costs the broker
# announcements and not the manager.
RUN pip3 install --no-cache-dir --break-system-packages paho-mqtt || \
    echo "paho-mqtt unavailable — bus events will print and not publish"

WORKDIR /app

# The two halves of the tool, and two COPYs because they are two things: the
# package is what is imported, the scripts are what is RUN. Every docker verb is
# in the second and none in the first.
# ⚠️ THE SOURCE HALF IS A REAL PATH IN THE CHECKOUT AND THE TARGET HALF IS NOT.
#    The folder on disk is `APK:PODS/APK:Docktor`; these two lines said
#    `APK:PODS/Docktor` and the build failed on a context path that has never
#    existed, while the in-image spellings below (APK:DOCKERS, APK:docktor) are
#    fine BECAUSE nothing outside the image resolves them — the runner puts
#    that directory on sys.path by walking, not by name.
COPY ["APK:PODS/APK:Docktor/SRC/manager", "/app/APK:DOCKERS/APK:docktor/SRC/manager"]
COPY ["APK:PODS/APK:Docktor/K8", "/app/APK:DOCKERS/APK:docktor/SRC/docker scripts"]
COPY ["APK:PODS/K8:runner.py", "/app/APK:DOCKERS/K8:runner.py"]

# paths.py reads the brand accent out of contracts/tokens/brand.json and
# DELIBERATELY HAS NO FALLBACK, so the token is not optional decoration here:
# without it `import manager.paths` raises at the first line.
COPY ["contracts/tokens/brand.json", "/app/APK:DOCKERS/APK:BareMetal/contracts/tokens/brand.json"]

# The broker order comes from this one module and there is no fallback list — a
# guess at the order is the defect that removes.
COPY ["APK:PODS/POD:APK/APK:BareMetal/SRC/Baremetal:Manager/mqtt_broker_discovery.py", "/app/APK:DOCKERS/APK:BareMetal/SRC/Baremetal:Manager/mqtt_broker_discovery.py"]

RUN chmod +x "/app/APK:DOCKERS/APK:docktor/SRC/docker scripts/"*.sh

# WHERE THE STORAGE VOLUME LANDS. An empty directory in the image, because a
# mount needs somewhere to be mounted: compose binds the named volume
# `docktor-storage` here, and storage-volume.sh writes the sample series into
# whichever of this path and the checkout folder is real.
# ⚠️ ANYTHING WRITTEN HERE AT BUILD TIME IS HIDDEN by that mount, and lost on
#    the next rebuild besides. The directory is the whole contribution.
RUN mkdir -p /storage

EXPOSE 8765

# ⚠️ SECURITY: 127.0.0.1, AND THE IMAGE NO LONGER DEFAULTS OTHERWISE. This API
#    has no authentication and can stop, rebuild and force-kill the ecosystem.
#    It used to be 0.0.0.0, safe for exactly one reason: the container had a
#    network of its own and compose published the port on the host loopback, so
#    the boundary was the control. The compose file now runs this service on
#    network_mode: host — every address endpoints.sh names is a host loopback and
#    a bridged manager could reach none of them — and on the host stack there is
#    no boundary and no mapping. A 0.0.0.0 default there is the bench on the LAN
#    one forgotten environment line away.
ENV APK_MANAGER_BIND=127.0.0.1
ENV APK_MANAGER_PORT=8765

# `--open` is deliberately absent and there is no flag to suppress it: a
# container has no browser to open and must not ask for one.
CMD ["sh", "-c", "python3 -u '/app/APK:DOCKERS/K8:runner.py' serve --bind ${APK_MANAGER_BIND} --port ${APK_MANAGER_PORT}"]
